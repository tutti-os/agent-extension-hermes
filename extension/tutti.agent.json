{
  "schemaVersion": "tutti.agent.manifest.v2",
  "agentKey": "hermes",
  "version": "1.0.5",
  "name": "Hermes Agent",
  "description": "Hermes Agent through the standard Agent Client Protocol",
  "icon": { "type": "asset", "src": "assets/icon.png" },
  "heroImage": { "type": "asset", "src": "assets/hero-image.jpg" },
  "runtime": {
    "kind": "standard-acp",
    "install": {
      "runner": "uv",
      "args": ["tool", "install", "hermes-agent[acp]==0.18.2"]
    },
    "launch": {
      "executable": "${installRoot}/bin/hermes",
      "args": ["acp"],
      "publishUserCommand": false
    }
  },
  "profiles": {
    "discovery": "profiles/discovery.json",
    "tools": "profiles/tools.json",
    "capabilities": "profiles/capabilities.json",
    "composer": "profiles/composer.json"
  },
  "localizationInfo": {
    "defaultLocale": "en",
    "defaultFile": "locales/en.json",
    "additionalLocales": [{ "locale": "zh-CN", "file": "locales/zh-CN.json" }]
  }
}
