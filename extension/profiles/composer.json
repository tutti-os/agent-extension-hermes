{
  "schemaVersion": "tutti.agent.composer.v1",
  "model": { "source": "acp-session-models" },
  "permission": { "source": "acp-session-modes" },
  "permissionModes": [{
    "runtimeId": "dont_ask",
    "semantic": "full-access",
    "automaticDecision": "approved"
  }],
  "slashCommands": {
    "commandCatalogAuthoritative": true,
    "commands": [
      { "name": "compact", "effect": "submitImmediate" },
      { "name": "help" },
      { "name": "model" },
      { "name": "tools" },
      { "name": "context" },
      { "name": "reset" },
      { "name": "steer" },
      { "name": "queue" },
      { "name": "version" }
    ]
  },
  "skills": {
    "invocation": "textTrigger",
    "triggerPrefix": "/",
    "roots": [
      { "scope": "workspace", "path": ".agent_context/skills" },
      { "scope": "user", "path": ".agent_context/skills" },
      { "scope": "user", "path": ".hermes/skills" }
    ]
  }
}
